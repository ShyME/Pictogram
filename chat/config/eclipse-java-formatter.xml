<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?eclipse-preferences version="1.0"?>
<profiles version="13">
  <profile kind="CodeFormatterProfile" name="Pictogram" version="13">
    <!-- 4-space indentation, no tabs. -->
    <setting id="org.eclipse.jdt.core.formatter.tabulation.char" value="space"/>
    <setting id="org.eclipse.jdt.core.formatter.tabulation.size" value="4"/>
    <setting id="org.eclipse.jdt.core.formatter.indentation.size" value="4"/>

    <!-- Single extra indent (not double) for wrapped lines: chained calls, method args, string concat. -->
    <setting id="org.eclipse.jdt.core.formatter.continuation_indentation" value="1"/>
    <setting id="org.eclipse.jdt.core.formatter.continuation_indentation_for_array_initializer" value="1"/>

    <setting id="org.eclipse.jdt.core.formatter.lineSplit" value="120"/>

    <!-- JDT defaults to never wrapping these, even past the line limit; force wrap-if-needed. -->
    <setting id="org.eclipse.jdt.core.formatter.alignment_for_arguments_in_annotation" value="16"/>
    <setting id="org.eclipse.jdt.core.formatter.alignment_for_expressions_in_array_initializer" value="16"/>

    <!-- K&amp;R: opening brace stays on the same line as the declaration/statement. -->
    <setting id="org.eclipse.jdt.core.formatter.brace_position_for_type_declaration" value="end_of_line"/>
    <setting id="org.eclipse.jdt.core.formatter.brace_position_for_method_declaration" value="end_of_line"/>
    <setting id="org.eclipse.jdt.core.formatter.brace_position_for_constructor_declaration" value="end_of_line"/>
    <setting id="org.eclipse.jdt.core.formatter.brace_position_for_block" value="end_of_line"/>
    <setting id="org.eclipse.jdt.core.formatter.brace_position_for_enum_declaration" value="end_of_line"/>
    <setting id="org.eclipse.jdt.core.formatter.brace_position_for_enum_constant" value="end_of_line"/>
    <setting id="org.eclipse.jdt.core.formatter.brace_position_for_switch" value="end_of_line"/>

    <!-- Empty bodies are never collapsed to `{}` on one line. -->
    <setting id="org.eclipse.jdt.core.formatter.insert_new_line_in_empty_method_body" value="insert"/>
    <setting id="org.eclipse.jdt.core.formatter.insert_new_line_in_empty_constructor_body" value="insert"/>
    <setting id="org.eclipse.jdt.core.formatter.insert_new_line_in_empty_block" value="insert"/>
    <setting id="org.eclipse.jdt.core.formatter.insert_new_line_in_empty_type_declaration" value="insert"/>
    <setting id="org.eclipse.jdt.core.formatter.insert_new_line_in_empty_enum_declaration" value="insert"/>
    <setting id="org.eclipse.jdt.core.formatter.insert_new_line_in_empty_enum_constant" value="insert"/>
    <setting id="org.eclipse.jdt.core.formatter.insert_new_line_in_empty_annotation_declaration" value="insert"/>
    <setting id="org.eclipse.jdt.core.formatter.insert_new_line_in_empty_record_declaration" value="insert"/>
  </profile>
</profiles>
