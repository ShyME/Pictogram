# Copy to `.env` and adjust. `.env` is gitignored and drives `compose.yaml` (the
# whole-app container run). `docker compose` loads it automatically.
#
# compose.dev.yaml (host development) ignores these — its credentials are fixed to
# match application-local.yml, which the host JVM reads instead of `.env`.

# --- PostgreSQL ---
POSTGRES_DB=pictogram
POSTGRES_USER=pictogram
POSTGRES_PASSWORD=pictogram

# --- Object storage (MinIO) ---
MINIO_ROOT_USER=pictogram
MINIO_ROOT_PASSWORD=pictogram

# --- App ---
# Host port the whole-app stack is published on.
PICTOGRAM_PORT=8080

# --- Google OIDC (see docs/adr/0004) ---
# Google sign-in for the whole-app container run. Leave these commented out to run
# without sign-in (the app still boots and serves everything else; /oauth2/** is denied).
# To enable it, set both and add them to the `app` service environment in compose.yaml as
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID / ..._CLIENT_SECRET.
# Host development (compose.dev.yaml) uses the bundled mock-oauth2-server instead — see
# application-local.yml.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
