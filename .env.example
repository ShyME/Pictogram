# Copy to `.env` and adjust. `.env` is gitignored and drives `compose.yaml` (the
# whole-app container run). `docker compose` loads it automatically.
#
# compose.dev.yaml (host development) ignores these — its credentials are fixed to
# match application-local.yml, which the host JVM reads instead of `.env`.

# --- PostgreSQL ---
POSTGRES_DB=pictogram
POSTGRES_USER=pictogram
POSTGRES_PASSWORD=pictogram

# --- Object storage (MinIO) ---
MINIO_ROOT_USER=pictogram
MINIO_ROOT_PASSWORD=pictogram

# --- App ---
# Host port the whole-app stack is published on — the single Caddy origin that fronts
# both `app` and `chat` (ADR-0014).
PICTOGRAM_PORT=8080
# Access-token signing key (P-256 private JWK, ADR-0004). compose.yaml ships a fixed dev key so
# `task up` works with no setup; set your own here for anything that outlives a demo — an
# ephemeral key breaks verification across replicas and on restart.
# PICTOGRAM_AUTH_SIGNING_KEY={"kty":"EC","crv":"P-256",...}

# --- Google OIDC (see docs/adr/0004) ---
# Only for `task up:google` (whole-app run against real Google). `task up` uses a bundled
# mock and needs nothing here; host development (compose.dev.yaml) uses the mock too.
# Create an OAuth 2.0 "Web application" client in the Google Cloud console with the
# redirect URI  http://localhost:8080/login/oauth2/code/google  and set both values:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Production deployment (compose.prod.yaml, ADR-0012) ---
# These live only in the box's `.env`, never committed. `scripts/deploy/wizard.sh`
# generates and writes them; the full rationale is docs/runbook/deployment.md. Every one
# is a hard `${VAR:?}` guard in compose.prod.yaml — a missing value fails the deploy.
#
# PICTOGRAM_DOMAIN=pictogram.imshy.me       # full subdomain Caddy issues a cert for (apex left free for another site)
# PICTOGRAM_TAG=latest                      # image tag to run; the Deploy workflow sets the commit SHA
# PICTOGRAM_AUTH_SIGNING_KEY={"kty":"EC","crv":"P-256","kid":"...","x":"...","y":"...","d":"..."}
# PICTOGRAM_AUTH_PUBLIC_KEY={"kty":"EC","crv":"P-256","kid":"...","x":"...","y":"..."}   # the signing key with "d" removed
# GOOGLE_CLIENT_ID=...                      # the *production* OAuth client (redirect https://<domain>/login/oauth2/code/google)
# GOOGLE_CLIENT_SECRET=...
# POSTGRES_PASSWORD, MINIO_ROOT_USER, MINIO_ROOT_PASSWORD  — set above to real generated values, not the dev defaults
