{
  "components" : {
    "schemas" : {
      "AccessTokenResponse" : {
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "expiresInSeconds" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "accessToken", "expiresInSeconds" ],
        "type" : "object"
      },
      "ApiPageFeedPost" : {
        "properties" : {
          "items" : {
            "items" : {
              "$ref" : "#/components/schemas/FeedPost"
            },
            "type" : "array"
          },
          "nextCursor" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "ApiPagePostView" : {
        "properties" : {
          "items" : {
            "items" : {
              "$ref" : "#/components/schemas/PostView"
            },
            "type" : "array"
          },
          "nextCursor" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "ApiPageUUID" : {
        "properties" : {
          "items" : {
            "items" : {
              "format" : "uuid",
              "type" : "string"
            },
            "type" : "array"
          },
          "nextCursor" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "EditProfileRequest" : {
        "properties" : {
          "bio" : {
            "type" : "string"
          },
          "displayName" : {
            "type" : "string"
          },
          "username" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "FeedPost" : {
        "properties" : {
          "authorId" : {
            "type" : "string"
          },
          "caption" : {
            "type" : "string"
          },
          "mediaId" : {
            "type" : "string"
          },
          "postId" : {
            "type" : "string"
          },
          "publishedAt" : {
            "format" : "date-time",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "FollowRelationship" : {
        "properties" : {
          "followedByViewer" : {
            "type" : "boolean"
          },
          "followerCount" : {
            "format" : "int64",
            "type" : "integer"
          },
          "followingCount" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "FollowRelationshipView" : {
        "properties" : {
          "followedByViewer" : {
            "type" : "boolean"
          },
          "followerCount" : {
            "format" : "int64",
            "type" : "integer"
          },
          "followingCount" : {
            "format" : "int64",
            "type" : "integer"
          },
          "userId" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "MediaUploadResponse" : {
        "properties" : {
          "mediaId" : {
            "type" : "string"
          }
        },
        "required" : [ "mediaId" ],
        "type" : "object"
      },
      "OnboardingRequest" : {
        "properties" : {
          "bio" : {
            "type" : "string"
          },
          "displayName" : {
            "type" : "string"
          },
          "username" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "PostView" : {
        "properties" : {
          "authorId" : {
            "type" : "string"
          },
          "caption" : {
            "type" : "string"
          },
          "mediaId" : {
            "type" : "string"
          },
          "postId" : {
            "type" : "string"
          },
          "publishedAt" : {
            "format" : "date-time",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "ProblemDetail" : {
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "format" : "uri",
            "type" : "string"
          },
          "properties" : {
            "additionalProperties" : { },
            "type" : "object"
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "format" : "uri",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "ProfileView" : {
        "properties" : {
          "bio" : {
            "type" : "string"
          },
          "displayName" : {
            "type" : "string"
          },
          "userId" : {
            "type" : "string"
          },
          "username" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "PublishPostRequest" : {
        "properties" : {
          "caption" : {
            "type" : "string"
          },
          "mediaId" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "The HTTP API the Pictogram SPA drives.",
    "title" : "Pictogram API",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/auth/logout" : {
      "post" : {
        "operationId" : "logout",
        "responses" : {
          "204" : {
            "description" : "The session is ended and the refresh cookie cleared."
          }
        },
        "tags" : [ "auth-controller" ]
      }
    },
    "/api/auth/refresh" : {
      "post" : {
        "operationId" : "refresh",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AccessTokenResponse"
                }
              }
            },
            "description" : "A fresh access token; the refresh cookie is rotated."
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The refresh cookie is missing, already used, or expired."
          }
        },
        "tags" : [ "auth-controller" ]
      }
    },
    "/api/feed" : {
      "get" : {
        "operationId" : "feed",
        "parameters" : [ {
          "in" : "query",
          "name" : "cursor",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "limit",
          "required" : false,
          "schema" : {
            "format" : "int32",
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiPageFeedPost"
                }
              }
            },
            "description" : "A page of the viewer's feed, newest post first."
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The pagination cursor is malformed."
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The caller has no valid access token."
          }
        },
        "tags" : [ "feed-controller" ]
      }
    },
    "/api/follows" : {
      "get" : {
        "operationId" : "relationshipsByIds",
        "parameters" : [ {
          "in" : "query",
          "name" : "ids",
          "required" : true,
          "schema" : {
            "items" : {
              "format" : "uuid",
              "type" : "string"
            },
            "type" : "array",
            "uniqueItems" : true
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/FollowRelationshipView"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "The viewer's follow standing with each requested user."
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The request asked for more ids than the batch limit."
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The caller has no valid access token."
          }
        },
        "tags" : [ "follow-controller" ]
      }
    },
    "/api/follows/{userId}" : {
      "delete" : {
        "operationId" : "unfollow",
        "parameters" : [ {
          "in" : "path",
          "name" : "userId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "The viewer no longer follows the user (or never did)."
          }
        },
        "tags" : [ "follow-controller" ]
      },
      "get" : {
        "operationId" : "relationship",
        "parameters" : [ {
          "in" : "path",
          "name" : "userId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FollowRelationship"
                }
              }
            },
            "description" : "The user's follower / following counts and the viewer's relationship."
          }
        },
        "tags" : [ "follow-controller" ]
      },
      "put" : {
        "operationId" : "follow",
        "parameters" : [ {
          "in" : "path",
          "name" : "userId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "The viewer now follows the user (or already did)."
          },
          "422" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The viewer tried to follow themselves."
          }
        },
        "tags" : [ "follow-controller" ]
      }
    },
    "/api/follows/{userId}/followers" : {
      "get" : {
        "operationId" : "followers",
        "parameters" : [ {
          "in" : "path",
          "name" : "userId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "cursor",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "limit",
          "required" : false,
          "schema" : {
            "format" : "int32",
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiPageUUID"
                }
              }
            },
            "description" : "A page of the users who follow this user, newest follow first."
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The caller has no valid access token."
          }
        },
        "tags" : [ "follow-controller" ]
      }
    },
    "/api/follows/{userId}/following" : {
      "get" : {
        "operationId" : "following",
        "parameters" : [ {
          "in" : "path",
          "name" : "userId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "cursor",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "limit",
          "required" : false,
          "schema" : {
            "format" : "int32",
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiPageUUID"
                }
              }
            },
            "description" : "A page of the users this user follows, newest follow first."
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The caller has no valid access token."
          }
        },
        "tags" : [ "follow-controller" ]
      }
    },
    "/api/media" : {
      "post" : {
        "operationId" : "upload",
        "requestBody" : {
          "content" : {
            "multipart/form-data" : {
              "schema" : {
                "properties" : {
                  "file" : {
                    "format" : "binary",
                    "type" : "string"
                  }
                },
                "required" : [ "file" ],
                "type" : "object"
              }
            }
          }
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MediaUploadResponse"
                }
              }
            },
            "description" : "The image was accepted and re-encoded."
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The upload is missing, empty, or not a readable image."
          }
        },
        "tags" : [ "media-controller" ]
      }
    },
    "/api/media/{mediaId}/original" : {
      "get" : {
        "operationId" : "original",
        "parameters" : [ {
          "in" : "path",
          "name" : "mediaId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "image/jpeg" : {
                "schema" : {
                  "format" : "binary",
                  "type" : "string"
                }
              }
            },
            "description" : "The full-size canonical JPEG."
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "No media has that id."
          }
        },
        "tags" : [ "media-controller" ]
      }
    },
    "/api/media/{mediaId}/thumbnail" : {
      "get" : {
        "operationId" : "thumbnail",
        "parameters" : [ {
          "in" : "path",
          "name" : "mediaId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "image/jpeg" : {
                "schema" : {
                  "format" : "binary",
                  "type" : "string"
                }
              }
            },
            "description" : "The square thumbnail JPEG."
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "No media has that id."
          }
        },
        "tags" : [ "media-controller" ]
      }
    },
    "/api/posts" : {
      "get" : {
        "operationId" : "timeline",
        "parameters" : [ {
          "in" : "query",
          "name" : "author",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "cursor",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "limit",
          "required" : false,
          "schema" : {
            "format" : "int32",
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiPagePostView"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "posts-controller" ]
      },
      "post" : {
        "operationId" : "publish",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PublishPostRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PostView"
                }
              }
            },
            "description" : "The post was published.",
            "headers" : {
              "Location" : {
                "description" : "The post's URL — id-based, live once a post-detail read lands.",
                "schema" : {
                  "type" : "string"
                },
                "style" : "simple"
              }
            }
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The caption is longer than 2200 characters."
          },
          "422" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The image can't be used — no such media, or it belongs to someone else."
          }
        },
        "tags" : [ "posts-controller" ]
      }
    },
    "/api/posts/{postId}" : {
      "delete" : {
        "operationId" : "delete",
        "parameters" : [ {
          "in" : "path",
          "name" : "postId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "204" : {
