{
  "components" : {
    "schemas" : {
      "AccessTokenResponse" : {
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "expiresInSeconds" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "accessToken", "expiresInSeconds" ],
        "type" : "object"
      },
      "ApiPageFeedCard" : {
        "properties" : {
          "items" : {
            "items" : {
              "$ref" : "#/components/schemas/FeedCard"
            },
            "type" : "array"
          },
          "nextCursor" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "FeedCard" : {
        "properties" : {
          "author" : {
            "type" : "string"
          },
          "postId" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "OnboardingRequest" : {
        "properties" : {
          "bio" : {
            "type" : "string"
          },
          "displayName" : {
            "type" : "string"
          },
          "username" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "ProblemDetail" : {
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "format" : "uri",
            "type" : "string"
          },
          "properties" : {
            "additionalProperties" : { },
            "type" : "object"
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "format" : "uri",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "ProfileView" : {
        "properties" : {
          "bio" : {
            "type" : "string"
          },
          "displayName" : {
            "type" : "string"
          },
          "userId" : {
            "type" : "string"
          },
          "username" : {
            "type" : "string"
          }
        },
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "The HTTP API the Pictogram SPA drives.",
    "title" : "Pictogram API",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/auth/logout" : {
      "post" : {
        "operationId" : "logout",
        "responses" : {
          "204" : {
            "description" : "The session is ended and the refresh cookie cleared."
          }
        },
        "tags" : [ "auth-controller" ]
      }
    },
    "/api/auth/refresh" : {
      "post" : {
        "operationId" : "refresh",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AccessTokenResponse"
                }
              }
            },
            "description" : "A fresh access token; the refresh cookie is rotated."
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The refresh cookie is missing, already used, or expired."
          }
        },
        "tags" : [ "auth-controller" ]
      }
    },
    "/api/feed" : {
      "get" : {
        "operationId" : "feed",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiPageFeedCard"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "feed-controller" ]
      }
    },
    "/api/profiles" : {
      "get" : {
        "operationId" : "byIds",
        "parameters" : [ {
          "in" : "query",
          "name" : "ids",
          "required" : true,
          "schema" : {
            "items" : {
              "format" : "uuid",
              "type" : "string"
            },
            "type" : "array",
            "uniqueItems" : true
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/ProfileView"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "The batch of profiles for the ids that have one."
          }
        },
        "tags" : [ "profiles-controller" ]
      },
      "post" : {
        "operationId" : "onboard",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/OnboardingRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProfileView"
                }
              }
            },
            "description" : "The profile was created.",
            "headers" : {
              "Location" : {
                "description" : "The new profile's URL, by username.",
                "schema" : {
                  "type" : "string"
                },
                "style" : "simple"
              }
            }
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The username is malformed, or the display name or bio is invalid."
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The username is taken, or this account has already onboarded."
          }
        },
        "tags" : [ "profiles-controller" ]
      }
    },
    "/api/profiles/me" : {
      "get" : {
        "operationId" : "me",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProfileView"
                }
              }
            },
            "description" : "The caller's own profile."
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The caller has no profile yet — they have not onboarded."
          }
        },
        "tags" : [ "profiles-controller" ]
      }
    },
    "/api/profiles/{username}" : {
      "get" : {
        "operationId" : "byUsername",
        "parameters" : [ {
          "in" : "path",
          "name" : "username",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProfileView"
                }
              }
            },
            "description" : "The public profile for that username."
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "No user has that username."
          }
        },
        "tags" : [ "profiles-controller" ]
      }
    }
  },
  "servers" : [ {
    "url" : "/"
  } ]
}
